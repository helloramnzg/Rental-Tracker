# Test-only overrides, loaded on top of .env.local by tests/support/load-env.ts.
# Contains no real secrets — Resend is always mocked in tests, so
# RESEND_API_KEY is never read. Safe to commit; copy to .env.test locally
# (gitignored) if you want different values than the ones below.

# Fake sender/recipient — services/notifications/send-reminder-email.ts
# only requires these to be non-empty to proceed past its config check.
FROM_EMAIL=test@upa-os.local
OWNER_EMAIL=landlord-test@upa-os.local

# Matches the Bearer token tests/integration/notifications send when
# calling the /api/cron/* route handlers directly.
CRON_SECRET=test-cron-secret

# Must be a real, working account on the LOCAL Supabase instance.
# tests/support/ensure-test-user.ts creates/repairs it automatically via
# the service-role Auth admin API before any suite runs — matches the
# documented test landlord account in HANDOVER.md.
TEST_LANDLORD_EMAIL=landlord@example.com
TEST_LANDLORD_PASSWORD=Landlord123!
