# Supabase (docs/architecture/08-authentication.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth, for local Supabase (supabase/config.toml [auth.external.google]).
# Set enabled = true in that file once these are populated. Client ID/secret
# come from Google Cloud Console; the Supabase-hosted project's Google
# provider is configured separately in the Supabase Dashboard.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Resend (docs/architecture/09-email-automation.md)
RESEND_API_KEY=
FROM_EMAIL=
OWNER_EMAIL=

# Vercel Cron auth — Vercel attaches this as a Bearer token automatically
# when set as a project env var. Required so /api/cron/* isn't a public,
# unauthenticated way to trigger a real email send.
CRON_SECRET=

# App
APP_URL=http://localhost:3000
